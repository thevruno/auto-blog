{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "check:discovery": "tsx scripts/check-discovery.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:import": "tsx scripts/db-import.ts",
    "db:transfer": "npm run db:export && npm run db:import"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.9",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "sharp": "0.35.4",
    "postcss": "8.5.28",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
