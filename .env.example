# ---------------------------------------------------------------------------
# Base de datos (obligatorio)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string
# Usá la cadena del "Session pooler" (IPv4, soporta DDL):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Opcional (recomendado si la app corre en serverless): separar la conexión de
# la app (transaction pooler, 6543) de la de migraciones (session pooler, 5432).
#   DATABASE_URL=postgresql://postgres.<REF>:<PASS>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<REF>:<PASS>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Para desarrollo local sin Supabase alcanza con una base local:
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/app_db

# La app agrega `sslmode=require` automáticamente si el host es de Supabase.
# Si tu cliente exige la semántica vieja de libpq (sin validar el certificado):
#   …?uselibpqcompat=true&sslmode=require

# ---------------------------------------------------------------------------
# Supabase Storage (opcional: si falta, las imágenes se guardan en el servidor)
# ---------------------------------------------------------------------------
# Project Settings → API
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# La service_role key SOLO se usa del lado del servidor (subida de imágenes).
# No la expongas en el cliente ni en el repositorio.
# SUPABASE_SERVICE_ROLE_KEY=
# Bucket público donde se guardan las imágenes (se crea solo si no existe):
# SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Sesión del panel (obligatorio en producción)
# ---------------------------------------------------------------------------
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# URL pública del sitio (metadatos, sitemap y enlaces absolutos)
NEXT_PUBLIC_SITE_URL=https://elenakuchimpos.com

# ---------------------------------------------------------------------------
# Rastreo web (todas opcionales)
# ---------------------------------------------------------------------------
# Clave para permitir el rastreo automático desde un cron externo:
#   curl -X POST "https://tu-sitio.com/api/cron/discovery?key=..."
DISCOVERY_CRON_KEY=

# API de YouTube Data v3: hace más estable la búsqueda de videos
# (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# Alternativas para la búsqueda de videos si YouTube bloquea las consultas
PIPED_BASE_URL=
INVIDIOUS_BASE_URL=

# ---------------------------------------------------------------------------
# Correo del formulario de contacto (opcional: sin SMTP se guarda en la base)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=
